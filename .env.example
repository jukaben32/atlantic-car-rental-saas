# -----------------------------------------------------------------------------
# Atlas needs exactly two values to run. Both come from your own Supabase
# project: Supabase Dashboard -> Project Settings -> API Keys (and Data API for
# the URL). Copy this file to `.env.local` for local development, and enter the
# same two values in your host's environment variables when you deploy.
#
# Both values are PUBLIC by design: every VITE_ variable is compiled into the
# browser bundle. Never put a secret key (sb_secret_...) or the service_role key
# here — the app refuses to start if it detects one.
#
# Optional settings (product name, map tiles, Stripe guide link) are documented
# in README.md under "Optional configuration". They are deliberately not listed
# here, so hosting panels that read this file only suggest what is required.
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key, starting with sb_publishable_. (Projects created before the
# new key format can use their legacy anon key here instead.)
VITE_SUPABASE_PUBLISHABLE_KEY=
